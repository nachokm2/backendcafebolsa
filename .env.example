# ─────────────────────────────────────────────────────────────
# INSTRUCCIONES:
#   1. Copia este archivo: cp .env.example .env
#   2. Rellena los valores reales en .env
#   3. NUNCA subas .env al repositorio (está en .gitignore)
# ─────────────────────────────────────────────────────────────

PORT=3001

# ── Base de datos PostgreSQL ──────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cafeteria_wallstreet
DB_USER=postgres
DB_PASSWORD=tu_password_aqui

# ── Motor de precios dinámicos (porcentajes) ──────────────────
PRICE_INCREASE_MIN=3
PRICE_INCREASE_MAX=5
PRICE_DECREASE_MIN=2
PRICE_DECREASE_MAX=5

# Intervalo de bajada automática en ms (300000 = 5 minutos)
PRICE_DECREASE_INTERVAL_MS=300000

# ── Impuestos ─────────────────────────────────────────────────
TAX_RATE=19

# ── JWT ───────────────────────────────────────────────────────
# Genera uno seguro con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cambia_este_valor_por_uno_seguro_de_64_bytes
JWT_EXPIRES_IN=8h

# ── CORS — orígenes permitidos (separados por coma) ───────────
# Incluye localhost:3000 (web) y orígenes del emulador/dispositivo móvil
CORS_ORIGINS=http://localhost:3000,http://10.0.2.2:3000,http://10.0.2.2:3001

# ── Entorno ───────────────────────────────────────────────────
NODE_ENV=development
